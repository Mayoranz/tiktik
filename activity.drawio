      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Activity Diagram - Proses Pembelian Tiket Event\n\nskinparam Style strictuml\nskinparam shadowing false\n\nstart\n\n:Masuk ke Home;\n:Lihat Daftar Event;\n:Pilih Event;\n\nif (Penjualan Sudah Dibuka?) then (Ya)\n\n    if (Waiting Room Aktif?) then (Ya)\n\n        :Masuk Waiting Room;\n        :Menunggu Giliran;\n\n    endif\n\n    :Pilih Kategori Tiket;\n\n    if (Numbered Seating?) then (Ya)\n        :Pilih Kursi;\n    endif\n\n    :Checkout;\n\n    :Validasi Maksimal Tiket;\n\n    if (Valid?) then (Ya)\n\n        :Lock Kursi;\n        :Generate Transaksi;\n        :Menampilkan Metode Pembayaran;\n        :Upload Bukti Pembayaran;\n\n        :Status = Pending;\n\n        partition Operator {\n\n            :Melihat Bukti Pembayaran;\n\n            if (Pembayaran Valid?) then (Approve)\n\n                :Approve Pembayaran;\n                :Generate QR Ticket;\n                :Status = Approved;\n                :Kursi = Booked;\n\n            else (Reject)\n\n                :Reject Pembayaran;\n                :Status = Rejected;\n                :Kursi = Available;\n\n            endif\n\n        }\n\n        partition Buyer {\n\n            if (Approved?) then (Ya)\n\n                :Melihat Tiket;\n                :Datang ke Lokasi Event;\n\n                partition Operator {\n\n                    :Scan QR Ticket;\n\n                    if (QR Valid?) then (Ya)\n\n                        if (Sudah Pernah Scan?) then (Ya)\n\n                            :Tolak Check-in;\n\n                        else (Belum)\n\n                            :Check-in Berhasil;\n                            :Status Ticket = Checked In;\n\n                        endif\n\n                    else (Tidak)\n\n                        :QR Tidak Valid;\n\n                    endif\n\n                }\n\n            else (Tidak)\n\n                :Transaksi Ditolak;\n\n            endif\n\n        }\n\n    else (Tidak)\n\n        :Pembelian Ditolak;\n\n    endif\n\nelse (Belum)\n\n    :Menunggu Countdown Penjualan;\n\nendif\n\nstop\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="H7rN_qczK7wpWM4So3ht-1">
