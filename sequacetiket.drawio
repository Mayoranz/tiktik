        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam Style strictuml\nskinparam shadowing false\nskinparam responseMessageBelowArrow true\n\ntitle Sequence Diagram - Scan QR Ticket / Check-in\n\nactor Operator\nactor Buyer\nparticipant \&quot;Scanner\&quot; as Scanner\nparticipant \&quot;Web System\&quot; as System\ndatabase \&quot;Database\&quot; as DB\n\n== Check-in ==\n\nBuyer -&gt; Operator : Menunjukkan QR Ticket\n\nOperator -&gt; Scanner : Scan QR Code\nScanner -&gt; System : Kirim QR Token\n\nSystem -&gt; DB : Cari QR Token\n\nalt QR Ditemukan\n\n    DB --&gt; System : Data Ticket\n\n    alt Ticket Sudah Di-scan\n\n        System --&gt; Scanner : QR Sudah Digunakan\n        Scanner --&gt; Operator : Check-in Ditolak\n\n    else Ticket Belum Di-scan\n\n        alt Event Masih Berlaku\n\n            System -&gt; DB : Update is_scanned = TRUE\n            System -&gt; DB : Update scanned_at\n\n            DB --&gt; System : Berhasil\n\n            System --&gt; Scanner : QR Valid\n            Scanner --&gt; Operator : Check-in Berhasil\n            Operator --&gt; Buyer : Dipersilakan Masuk\n\n        else Event Selesai / Tidak Berlaku\n\n            System --&gt; Scanner : Ticket Tidak Berlaku\n            Scanner --&gt; Operator : Check-in Ditolak\n\n        end\n\n    end\n\nelse QR Tidak Ditemukan\n\n    DB --&gt; System : Data Tidak Ada\n    System --&gt; Scanner : QR Tidak Valid\n    Scanner --&gt; Operator : Check-in Ditolak\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SDAANPTm8fQa5FRJ4X8y-1">
