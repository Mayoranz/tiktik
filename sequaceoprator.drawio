<mxfile host="Electron">
  <diagram name="Page-1" id="6KlJSDIX0NiR6Kbz0mvc">
    <mxGraphModel dx="3800" dy="2505" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam Style strictuml\nskinparam shadowing false\nskinparam responseMessageBelowArrow true\n\ntitle Sequence Diagram - Kelola Event (Operator)\n\nactor Operator\nparticipant \&quot;Web System\&quot; as System\ndatabase \&quot;Database\&quot; as DB\n\n== Login ==\n\nOperator -&gt; System : Login\nSystem -&gt; DB : Validasi akun operator\nDB --&gt; System : Data operator\nSystem --&gt; Operator : Dashboard Operator\n\n== Membuat Event ==\n\nOperator -&gt; System : Tambah Event\nSystem --&gt; Operator : Form Event\n\nOperator -&gt; System : Input data event\\n(judul, deskripsi, lokasi,\\ntanggal, countdown)\nSystem -&gt; DB : Simpan Event\nDB --&gt; System : Event berhasil dibuat\nSystem --&gt; Operator : Event tersimpan\n\n== Upload Banner ==\n\nOperator -&gt; System : Upload Banner\nloop Setiap Banner\n    System -&gt; DB : Simpan Banner\nend\nDB --&gt; System : Banner tersimpan\nSystem --&gt; Operator : Banner berhasil ditambahkan\n\n== Kelola Tiket ==\n\nOperator -&gt; System : Tambah Kategori Tiket\n\nloop Setiap Kategori Tiket\n\n    Operator -&gt; System : Input nama, harga, kuota\n    System -&gt; DB : Simpan Ticket Type\n\n    alt Numbered Seating\n\n        loop Setiap Kursi\n\n            Operator -&gt; System : Input nomor kursi\n            System -&gt; DB : Simpan Seat\n\n        end\n\n    else Free Standing\n\n        System -&gt; DB : Simpan kategori tiket\n\n    end\n\nend\n\nDB --&gt; System : Data tiket berhasil disimpan\nSystem --&gt; Operator : Kategori tiket berhasil dibuat\n\n== Metode Pembayaran ==\n\nOperator -&gt; System : Tambah Metode Pembayaran\n\nalt Transfer Bank\n\n    Operator -&gt; System : Input rekening\n    System -&gt; DB : Simpan rekening\n\nelse QRIS\n\n    Operator -&gt; System : Upload QRIS\n    System -&gt; DB : Simpan QRIS\n\nend\n\nDB --&gt; System : Metode pembayaran tersimpan\nSystem --&gt; Operator : Data berhasil disimpan\n\n== Verifikasi Pembayaran ==\n\nOperator -&gt; System : Buka transaksi pending\nSystem -&gt; DB : Ambil transaksi pending\nDB --&gt; System : Daftar transaksi\nSystem --&gt; Operator : Tampilkan transaksi\n\nOperator -&gt; System : Pilih transaksi\n\nalt Approve\n\n    Operator -&gt; System : Approve pembayaran\n\n    System -&gt; DB : Update status transaksi\n    System -&gt; DB : Generate Ticket\n    System -&gt; DB : Generate QR Code\n    System -&gt; DB : Update Seat = Booked\n\n    DB --&gt; System : Berhasil\n    System --&gt; Operator : Pembayaran berhasil disetujui\n\nelse Reject\n\n    Operator -&gt; System : Reject pembayaran\n\n    System -&gt; DB : Update status transaksi\n    System -&gt; DB : Seat Available kembali\n\n    DB --&gt; System : Berhasil\n    System --&gt; Operator : Pembayaran ditolak\n\nend\n\n== Scan QR Ticket ==\n\nOperator -&gt; System : Scan QR Ticket\nSystem -&gt; DB : Validasi QR\n\nalt QR Valid\n\n    DB --&gt; System : Data Ticket\n\n    alt Belum Pernah Scan\n\n        System -&gt; DB : Update is_scanned = TRUE\n        System -&gt; DB : Update scanned_at\n        System --&gt; Operator : Check-in Berhasil\n\n    else Sudah Scan\n\n        System --&gt; Operator : QR Sudah Digunakan\n\n    end\n\nelse QR Tidak Valid\n\n    System --&gt; Operator : QR Tidak Valid\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="da14zar9CvddjMbv0qcU-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
