        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam Style strictuml\nskinparam shadowing false\nskinparam responseMessageBelowArrow true\n\ntitle Sequence Diagram - Pembelian Tiket\n\nactor Buyer\nparticipant \&quot;Web System\&quot; as System\ndatabase \&quot;Database\&quot; as DB\nparticipant \&quot;Waiting Room\&quot; as Queue\nparticipant \&quot;Operator\&quot; as Operator\n\nBuyer -&gt; System : Buka Home\nSystem -&gt; DB : Ambil daftar event\nDB --&gt; System : Data event\nSystem --&gt; Buyer : Tampilkan event\n\nBuyer -&gt; System : Pilih event\nSystem -&gt; DB : Ambil detail event\nDB --&gt; System : Detail event\nSystem --&gt; Buyer : Tampilkan detail\n\nBuyer -&gt; System : Klik Beli Tiket\n\nalt Waiting Room Aktif\n\n    System -&gt; Queue : Daftarkan antrean\n    Queue --&gt; Buyer : Nomor antrean\n\n    loop Menunggu giliran\n        Queue --&gt; Buyer : Update posisi antrean\n    end\n\n    Queue --&gt; System : Buyer mendapat giliran\n\nend\n\nBuyer -&gt; System : Pilih kategori tiket\n\nalt Numbered Seating\n\n    Buyer -&gt; System : Pilih kursi\n    System -&gt; DB : Cek status kursi\n\n    alt Kursi tersedia\n\n        DB --&gt; System : Available\n        System -&gt; DB : Lock kursi\n\n    else Kursi sudah dipilih\n\n        DB --&gt; System : Locked / Booked\n        System --&gt; Buyer : Pilih kursi lain\n\n    end\n\nend\n\nBuyer -&gt; System : Checkout\nSystem -&gt; DB : Validasi batas pembelian\n\nalt Valid\n\n    DB --&gt; System : OK\n\n    System -&gt; DB : Simpan transaksi\n    DB --&gt; System : Transaction Created\n\n    System --&gt; Buyer : Tampilkan pembayaran\n\n    Buyer -&gt; System : Upload bukti pembayaran\n    System -&gt; DB : Simpan bukti transfer\n\n    System --&gt; Buyer : Status Pending\n\n    Operator -&gt; System : Buka verifikasi pembayaran\n    System -&gt; DB : Ambil transaksi pending\n    DB --&gt; System : Data transaksi\n\n    alt Pembayaran valid\n\n        Operator -&gt; System : Approve\n\n        System -&gt; DB : Update transaksi\n        System -&gt; DB : Generate tiket\n        System -&gt; DB : Generate QR Code\n        System -&gt; DB : Ubah kursi menjadi Booked\n\n        System --&gt; Buyer : Tiket tersedia\n\n    else Pembayaran tidak valid\n\n        Operator -&gt; System : Reject\n\n        System -&gt; DB : Update status Rejected\n        System -&gt; DB : Buka kembali kursi\n\n        System --&gt; Buyer : Pembayaran ditolak\n\n    end\n\nelse Melebihi batas tiket\n\n    DB --&gt; System : Tidak valid\n    System --&gt; Buyer : Pembelian ditolak\n\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="rLz31nUPSHVbyKLqd7rM-1">
