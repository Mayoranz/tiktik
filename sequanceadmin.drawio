        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nskinparam Style strictuml\nskinparam shadowing false\nskinparam responseMessageBelowArrow true\n\ntitle Sequence Diagram - Kelola Platform (Admin)\n\nactor Admin\nparticipant \&quot;Web System\&quot; as System\ndatabase \&quot;Database\&quot; as DB\n\n== Login ==\n\nAdmin -&gt; System : Login\nSystem -&gt; DB : Validasi akun admin\nDB --&gt; System : Data admin\nSystem --&gt; Admin : Dashboard Admin\n\n== Kelola Operator ==\n\nAdmin -&gt; System : Buka menu Operator\nSystem -&gt; DB : Ambil daftar operator\nDB --&gt; System : Data operator\nSystem --&gt; Admin : Tampilkan daftar operator\n\nAdmin -&gt; System : Pilih operator\n\nalt Approve Operator\n\n    Admin -&gt; System : Approve\n    System -&gt; DB : Update status operator = Active\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Operator berhasil diapprove\n\nelse Suspend Operator\n\n    Admin -&gt; System : Suspend\n    System -&gt; DB : Update status operator = Suspended\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Operator disuspend\n\nelse Blokir Operator\n\n    Admin -&gt; System : Blokir\n    System -&gt; DB : Update status operator = Blocked\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Operator diblokir\n\nend\n\n== Kelola Pengguna ==\n\nAdmin -&gt; System : Buka menu Pengguna\nSystem -&gt; DB : Ambil data pengguna\nDB --&gt; System : Data pengguna\nSystem --&gt; Admin : Tampilkan daftar pengguna\n\nAdmin -&gt; System : Pilih pengguna\n\nalt Ban Pengguna\n\n    Admin -&gt; System : Ban akun\n    System -&gt; DB : Update status user = Banned\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Pengguna diblokir\n\nelse Reset Password\n\n    Admin -&gt; System : Reset Password\n    System -&gt; DB : Update password baru\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Password berhasil direset\n\nend\n\n== Kelola Event ==\n\nAdmin -&gt; System : Buka menu Event\nSystem -&gt; DB : Ambil seluruh event\nDB --&gt; System : Data event\nSystem --&gt; Admin : Tampilkan daftar event\n\nAdmin -&gt; System : Pilih event\n\nalt Featured Event\n\n    Admin -&gt; System : Jadikan Featured\n    System -&gt; DB : Update is_featured = TRUE\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Event menjadi Featured\n\nelse Moderasi Event\n\n    Admin -&gt; System : Nonaktifkan Event\n    System -&gt; DB : Update status = Cancelled\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Event dinonaktifkan\n\nend\n\n== Pengaturan Sistem ==\n\nAdmin -&gt; System : Buka Pengaturan Sistem\nSystem -&gt; DB : Ambil konfigurasi sistem\nDB --&gt; System : Data konfigurasi\nSystem --&gt; Admin : Tampilkan pengaturan\n\nAdmin -&gt; System : Simpan perubahan\nSystem -&gt; DB : Update konfigurasi\nDB --&gt; System : Berhasil\nSystem --&gt; Admin : Pengaturan berhasil disimpan\n\nalt Maintenance Mode\n\n    Admin -&gt; System : Aktifkan / Nonaktifkan Maintenance\n    System -&gt; DB : Update maintenance mode\n    DB --&gt; System : Berhasil\n    System --&gt; Admin : Status maintenance diperbarui\n\nend\n\n== Activity Log ==\n\nAdmin -&gt; System : Lihat Activity Log\nSystem -&gt; DB : Ambil data log\nDB --&gt; System : Activity Log\nSystem --&gt; Admin : Tampilkan Activity Log\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VtmTEShiD3Z4u80P1EGW-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
