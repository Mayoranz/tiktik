<mxfile host="Electron">
  <diagram name="ERD" id="0">
    <mxGraphModel dx="1700" dy="1253" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle ERD - SaaS Ticketing Platform\n\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\nskinparam roundcorner 8\n\nentity Users {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  username : VARCHAR(50)\n  nik : CHAR(16)\n  email : VARCHAR(100)\n  phone : VARCHAR(20)\n  password : VARCHAR(255)\n  role : ENUM\n  remember_token : VARCHAR(100)\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity Events {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * operator_id : BIGINT &lt;&lt;FK&gt;&gt;\n  title : VARCHAR(150)\n  description : TEXT\n  location_name : VARCHAR(150)\n  google_maps_url : TEXT\n  event_date : DATETIME\n  ticket_sales_start : DATETIME\n  status : ENUM\n  is_exclusive : BOOLEAN\n  is_featured : BOOLEAN\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity EventBanners {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * event_id : BIGINT &lt;&lt;FK&gt;&gt;\n  image_url : VARCHAR(255)\n  created_at : TIMESTAMP\n}\n\nentity TicketTypes {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * event_id : BIGINT &lt;&lt;FK&gt;&gt;\n  name : VARCHAR(100)\n  price : DECIMAL(12,2)\n  quota : INT\n  is_numbered_seating : BOOLEAN\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity Seats {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * ticket_type_id : BIGINT &lt;&lt;FK&gt;&gt;\n  seat_number : VARCHAR(20)\n  status : ENUM\n  locked_until : DATETIME\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity PaymentMethods {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * event_id : BIGINT &lt;&lt;FK&gt;&gt;\n  method : ENUM\n  bank_name : VARCHAR(100)\n  account_name : VARCHAR(100)\n  account_number : VARCHAR(100)\n  qris_image : VARCHAR(255)\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity Transactions {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * event_id : BIGINT &lt;&lt;FK&gt;&gt;\n  total_amount : DECIMAL(12,2)\n  payment_proof : VARCHAR(255)\n  status : ENUM\n  expires_at : DATETIME\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nentity TransactionItems {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * transaction_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * ticket_type_id : BIGINT &lt;&lt;FK&gt;&gt;\n  quantity : INT\n  price : DECIMAL(12,2)\n  subtotal : DECIMAL(12,2)\n  created_at : TIMESTAMP\n}\n\nentity Tickets {\n  * id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * transaction_id : BIGINT &lt;&lt;FK&gt;&gt;\n  * ticket_type_id : BIGINT &lt;&lt;FK&gt;&gt;\n  seat_id : BIGINT &lt;&lt;FK&gt;&gt;\n  qr_code_token : VARCHAR(255)\n  is_scanned : BOOLEAN\n  scanned_at : DATETIME\n  created_at : TIMESTAMP\n  updated_at : TIMESTAMP\n}\n\nUsers ||--o{ Events : manages\nEvents ||--o{ EventBanners : has\nEvents ||--o{ TicketTypes : contains\nTicketTypes ||--o{ Seats : owns\nEvents ||--o{ PaymentMethods : uses\n\nUsers ||--o{ Transactions : makes\nEvents ||--o{ Transactions : for\n\nTransactions ||--o{ TransactionItems : contains\nTicketTypes ||--o{ TransactionItems : selected\n\nTransactions ||--o{ Tickets : generates\nTicketTypes ||--o{ Tickets : type\nSeats ||--o| Tickets : assigned\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9c8-OupwPiRR-4MSugwj-1">
